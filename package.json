{
  "name": "flowpad",
  "version": "0.22.0",
  "description": "Anchor — a working protocol for building software with AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demirsefa/flowpad-anchor.git"
  },
  "keywords": [
    "ai",
    "agents",
    "protocol",
    "contracts",
    "conventions"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "protocol",
    "principles",
    "guides",
    "skills"
  ],
  "bin": {
    "flowpad": "bin/flowpad.js"
  },
  "scripts": {
    "prepare": "husky",
    "test": "node --test test/cli.test.js test/neutrality.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "eslint . && prettier --check . && node --test test/cli.test.js test/neutrality.test.js && node scripts/leak-check.js",
    "leak-check": "node scripts/leak-check.js",
    "prepublishOnly": "npm test && node scripts/leak-check.js"
  },
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  }
}
